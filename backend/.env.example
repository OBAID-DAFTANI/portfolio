NODE_ENV=development
PORT=5050

# MongoDB Atlas connection string (same account you used for Firaasat works fine —
# just use a different database name, e.g. mongodb+srv://user:pass@cluster.mongodb.net/portfolio)
MONGODB_URI=

# Your deployed frontend URL (for CORS). Use http://localhost:5173 for local dev.
CLIENT_URL=http://localhost:5173
